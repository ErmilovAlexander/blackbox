{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "clusterName", "retention", "persistence", "serviceAccount", "rbac"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(|sha256:[a-f0-9]{64})$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "clusterName": {"type": "string", "minLength": 1},
    "includeConfigMaps": {"type": "boolean"},
    "retention": {"type": "string", "pattern": "^[0-9]+(ns|us|µs|ms|s|m|h)$"},
    "maxStoreBytes": {"type": "integer", "minimum": 0},
    "maxSegmentBytes": {"type": "integer", "minimum": 1},
    "persistence": {
      "type": "object",
      "required": ["enabled", "keep", "existingClaim", "accessModes", "size", "storageClass"],
      "properties": {
        "enabled": {"type": "boolean"},
        "keep": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "size": {"type": "string", "minLength": 1},
        "storageClass": {"type": "string"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "required": ["create", "name"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"}
      }
    },
    "rbac": {
      "type": "object",
      "required": ["create"],
      "properties": {"create": {"type": "boolean"}}
    },
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0}
  }
}
